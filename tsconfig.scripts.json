{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "fvtt-types"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": false,
        "sourceMap": false
    },
    "include": ["sync/**/*.ts", "tests/**/*.ts", "src/rulesets/sf2e/statblock/**/*.ts", "src/sync/**/*.ts", "src/types/**/*.d.ts"],
    "exclude": ["node_modules"]
}
