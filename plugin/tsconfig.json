{
    "compilerOptions": {
        "target": "ES2018",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "ES2018"],
        "types": [],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "noEmit": true,
        "rootDir": "src",
        "baseUrl": "."
    },
    "include": ["src/**/*.ts"]
}
