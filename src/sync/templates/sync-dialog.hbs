<div class="codex-sync-dialog">
    {{#if report}}
        <section class="codex-sync-report">
            <h3>{{localize "codex-foundry.sync.reportTitle"}}</h3>
            <ul class="codex-sync-report-counts">
                <li>{{localize "codex-foundry.sync.reportCreated" count=report.created}}</li>
                <li>{{localize "codex-foundry.sync.reportUpdated" count=report.updated}}</li>
                <li>{{localize "codex-foundry.sync.reportAdopted" count=report.adopted}}</li>
                <li>{{localize "codex-foundry.sync.reportReimported" count=report.reimported}}</li>
                <li>{{localize "codex-foundry.sync.reportDeleted" count=report.deleted}}</li>
            </ul>
            {{#if report.failed.length}}
                <h4>{{localize "codex-foundry.sync.reportFailuresTitle"}}</h4>
                <ul class="codex-sync-report-failures">
                    {{#each report.failed}}
                        <li><strong>{{name}}</strong> — {{error}}</li>
                    {{/each}}
                </ul>
            {{/if}}
        </section>
    {{else}}
        {{#if unchanged}}
            <p class="codex-sync-unchanged">{{localize "codex-foundry.sync.unchanged" count=unchanged}}</p>
        {{/if}}

        {{#if adopt.length}}
            <section class="codex-sync-section">
                <h3>{{localize "codex-foundry.sync.sectionAdopt"}}</h3>
                <ul>
                    {{#each adopt}}
                        <li>
                            <label>
                                <input type="checkbox" name="adopt" value="{{key}}" checked>
                                {{name}} <span class="codex-sync-meta">({{docType}})</span>
                            </label>
                        </li>
                    {{/each}}
                </ul>
            </section>
        {{/if}}

        {{#if create.length}}
            <section class="codex-sync-section">
                <h3>{{localize "codex-foundry.sync.sectionCreate"}}</h3>
                <ul>
                    {{#each create}}
                        <li>{{name}} <span class="codex-sync-meta">({{docType}})</span></li>
                    {{/each}}
                </ul>
            </section>
        {{/if}}

        {{#if update.length}}
            <section class="codex-sync-section">
                <h3>{{localize "codex-foundry.sync.sectionUpdate"}}</h3>
                <ul>
                    {{#each update}}
                        <li>{{name}} <span class="codex-sync-meta">({{docType}})</span></li>
                    {{/each}}
                </ul>
            </section>
        {{/if}}

        {{#if reimport.length}}
            <section class="codex-sync-section">
                <h3>{{localize "codex-foundry.sync.sectionReimport"}}</h3>
                <ul>
                    {{#each reimport}}
                        <li>
                            <label>
                                <input type="checkbox" name="reimport" value="{{key}}">
                                {{name}}
                                {{#if modifiedInFoundry}}
                                    <i class="fa-solid fa-triangle-exclamation codex-sync-warning" title="{{localize "codex-foundry.sync.modifiedInFoundry"}}"></i>
                                    <span class="codex-sync-warning-label">{{localize "codex-foundry.sync.modifiedInFoundry"}}</span>
                                {{/if}}
                            </label>
                        </li>
                    {{/each}}
                </ul>
            </section>
        {{/if}}

        {{#if stale.length}}
            <section class="codex-sync-section">
                <h3>{{localize "codex-foundry.sync.sectionStale"}}</h3>
                <ul>
                    {{#each stale}}
                        <li>
                            <label>
                                <input type="checkbox" name="deleteStale" value="{{key}}">
                                {{localize "codex-foundry.sync.staleDeleteLabel" name=name docType=docType}}
                            </label>
                        </li>
                    {{/each}}
                </ul>
            </section>
        {{/if}}

        {{#unless hasWork}}
            <p class="codex-sync-empty">{{localize "codex-foundry.sync.nothingToApply"}}</p>
        {{/unless}}

        <footer class="codex-sync-footer">
            <button type="submit" {{#unless hasWork}}disabled{{/unless}}>
                <i class="fa-solid fa-check"></i> {{localize "codex-foundry.sync.apply"}}
            </button>
        </footer>
    {{/if}}
</div>
