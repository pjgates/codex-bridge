<div class="waypoint-label codex-waypoint {{cssClass}}">
    <div class="codex-mode-row">
        <strong>{{#if movementLabel}}{{movementLabel}}{{else}}{{localize action.label}}{{/if}}</strong>
        {{#unless hideBudget}}<span class="codex-action-budget" role="img" aria-label="{{budgetDescription}}" title="{{budgetDescription}}">
            {{#if actionCost}}<span class="action-glyph" aria-hidden="true">{{actionCost.actions}}</span>{{#if actionCost.overage}}<span class="overage" aria-hidden="true">+</span>{{/if}}
            {{else if budgetKnown}}<span aria-hidden="true">—</span>{{else}}{{budgetLabel}}{{/if}}
        </span>{{/unless}}
    </div>
    <div class="codex-measurement-row">
        <span class="codex-distance">
            <span aria-hidden="true">→</span>
            <span class="total-measurement">{{#if distanceSegments}}{{#each distanceSegments}}{{#unless @first}} + {{/unless}}{{this}} {{../units}}{{/each}}{{else}}{{distance.total}} {{units}}{{/if}}{{#if cost.additional.total}} + <span class="additional-cost" title="Additional terrain cost">{{cost.additional.total}} {{units}}</span>{{/if}}</span>
            {{#if distance.delta}}<span class="delta-measurement">({{distance.delta}}{{#if cost.additional.delta}} + {{cost.additional.delta}}{{/if}})</span>{{/if}}
        </span>
        {{#if remaining}}<span class="codex-remaining-movement" title="Remaining movement in this action">({{remaining}})</span>{{/if}}
    </div>
    {{#if (and elevation (not elevation.hidden))}}
        <div class="codex-elevation-row"><i class="{{elevation.icon}}" inert></i> {{elevation.total}} {{units}}{{#if elevation.delta}} ({{elevation.delta}}){{/if}}</div>
    {{/if}}
    {{#if terrain.paused}}
        <div class="codex-terrain-preview">
            {{#if terrain.reaction}}<span class="codex-reaction" role="img" aria-label="Reaction"><span class="action-glyph" aria-hidden="true">R</span></span>{{/if}}
            <span>{{warningLabel}}{{#if (and warningLabel terrain.hint)}} · {{/if}}{{terrain.hint}}</span>
        </div>
    {{/if}}
    {{#if (or squeezed secret)}}
        <div class="codex-measurement-details">
            {{#if squeezed}}<i class="fa-solid fa-compress codex-squeezed" aria-label="Squeezing"></i>{{/if}}
            {{#if secret}}<i class="fa-solid fa-eye-slash" aria-label="Hidden movement"></i>{{/if}}
        </div>
    {{/if}}
</div>
