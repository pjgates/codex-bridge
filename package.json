{
    "name": "codex-bridge",
    "version": "1.0.1",
    "description": "Codex bridge: Obsidian↔Foundry VTT content sync plus ruleset houserules",
    "type": "module",
    "scripts": {
        "push": "tsx sync/push.ts push",
        "build": "vite build",
        "watch": "vite build --watch",
        "test": "vitest run",
        "lint": "eslint src/",
        "typecheck:runtime": "tsc --noEmit -p tsconfig.json",
        "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
        "typecheck": "npm run typecheck:runtime && npm run typecheck:scripts",
        "verify": "npm run typecheck && npm run lint && npm test && npm run build",
        "clean": "rm -rf dist",
        "link": "echo 'Symlink to your Foundry modules folder: ln -s $(pwd) <foundryData>/Data/modules/codex-foundry'"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.10.0",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "commander": "^14.0.3",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-boundaries": "^5.4.0",
        "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
        "gray-matter": "^4.0.3",
        "happy-dom": "^20.9.0",
        "js-yaml": "^5.2.1",
        "marked": "^17.0.1",
        "sass": "~1.83.0",
        "tsx": "^4.21.0",
        "typescript": "~5.7.0",
        "vite": "~6.1.0",
        "vite-plugin-static-copy": "~2.3.0",
        "vitest": "^4.0.18"
    },
    "engines": {
        "node": ">=22.13"
    }
}
